{
  "name": "Medium squares, margin",
  "orientation": "portrait",
  "categories": ["Grids"],
  "constants": [
    {"compact": "templateWidth < 1000 || templateHeight < 1000"},
    {"pitch": 78.3},
    {"left": "paperOriginX + 469"},
    {"top": 0}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": "left", "y": "top", "width": "templateWidth", "height": "pitch"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", "parentWidth", 0]
        }
      ]
    },
    {
      "type": "group",
      "boundingBox": {"x": "left", "y": 0, "width": "pitch", "height": "templateHeight"},
      "repeat": {"rows": "down", "columns": "right"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", 0, "parentHeight"]
        }
      ]
    }
  ]
}
