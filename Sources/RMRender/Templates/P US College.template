{
  "name": "College rule",
  "orientation": "portrait",
  "categories": ["Lines"],
  "constants": [
    {"compact": "templateWidth < 1000 || templateHeight < 1000"},
    {"pitch": 62},
    {"top": "compact ? 160 : 176"},
    {"margin": "paperOriginX + 464"}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": 0, "y": "top", "width": "templateWidth", "height": "pitch"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", "parentWidth", 0]
        }
      ]
    },
    {
      "type": "group",
      "boundingBox": {"x": "margin", "y": 0, "height": "templateHeight"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", 0, "parentHeight"]
        }
      ]
    },
    {
      "type": "group",
      "boundingBox": {"x": "margin + 10", "y": 0, "height": "templateHeight"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", 0, "parentHeight"]
        }
      ]
    }
  ]
}
