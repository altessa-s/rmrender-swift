{
  "name": "Wide rule",
  "orientation": "portrait",
  "categories": ["Lines"],
  "constants": [
    {"compact": "templateWidth < 1000 || templateHeight < 1000"},
    {"pitch": 97},
    {"top": "compact ? 160 : 162"}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": 0, "y": "top", "width": "templateWidth", "height": "pitch"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", "parentWidth", 0]
        }
      ]
    }
  ]
}
