{
  "name": "Squares, lower half",
  "orientation": "landscape",
  "categories": ["Grids"],
  "constants": [
    {"compact": "templateWidth < 1000 || templateHeight < 1000"},
    {"pitch": 78.3},
    {"left": 0},
    {"edge": "compact ? templateHeight / 2 : 702"}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": 0, "y": "edge", "width": "templateWidth", "height": "pitch"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", "parentWidth", 0]
        }
      ]
    },
    {
      "type": "group",
      "boundingBox": {"x": "left", "y": "edge", "width": "pitch", "height": "templateHeight - edge"},
      "repeat": {"rows": "down", "columns": "right"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", 0, "parentHeight"]
        }
      ]
    }
  ]
}
