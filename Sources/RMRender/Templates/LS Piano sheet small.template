{
  "name": "Grand staff, small",
  "orientation": "landscape",
  "categories": ["Creative"],
  "constants": [
    {"compact": "templateWidth < 1000 || templateHeight < 1000"},
    {"span": "templateWidth - 120 < 1594 ? templateWidth - 120 : 1594"},
    {"top": "compact ? 120 : 185"},
    {"fits": "(templateHeight - top - 204 - 20) / 284 + 1"},
    {"space": 18},
    {"between": 132},
    {"depth": 204},
    {"left": "templateWidth / 2 - span / 2 + 10.15"}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": "left", "y": "top", "width": "span", "height": 284},
      "repeat": {"rows": "fits < 4 ? fits : 4"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", "parentWidth", 0, "M", 0, 18, "L", "parentWidth", 18, "M", 0, 36, "L", "parentWidth", 36, "M", 0, 54, "L", "parentWidth", 54, "M", 0, 72, "L", "parentWidth", 72]
        },
        {
          "type": "group",
          "boundingBox": {"x": 0, "y": "between", "width": "span"},
          "children": [
            {
              "type": "path",
              "data": ["M", 0, 0, "L", "parentWidth", 0, "M", 0, 18, "L", "parentWidth", 18, "M", 0, 36, "L", "parentWidth", 36, "M", 0, 54, "L", "parentWidth", 54, "M", 0, 72, "L", "parentWidth", 72]
            }
          ]
        },
        {
          "type": "path",
          "data": ["M", 0, 0, "L", 0, "depth", "M", "span", 0, "L", "span", "depth"]
        },
        {
          "type": "path",
          "data": ["M", -6, -8, "L", -16, -8, "L", -16, "depth + 8", "L", -6, "depth + 8"],
          "strokeWidth": 4,
          "strokeColor": "#5A5A5A"
        }
      ]
    }
  ]
}
