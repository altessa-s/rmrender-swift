{
  "name": "Isometric",
  "orientation": "portrait",
  "categories": ["Creative"],
  "constants": [
    {"half": 58.4},
    {"rise": 67.5},
    {"left": "paperOriginX - half"},
    {"run": "half * 2 * 18"},
    {"drop": "rise * 18"}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": "left", "y": 0, "width": "half", "height": "templateHeight"},
      "repeat": {"rows": "down", "columns": "right"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", 0, "parentHeight"]
        }
      ]
    },
    {
      "type": "group",
      "boundingBox": {"x": "left", "y": "0 - drop", "width": "run", "height": "rise"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", "run", "drop"]
        }
      ]
    },
    {
      "type": "group",
      "boundingBox": {"x": "left", "y": "0 - drop", "width": "run", "height": "rise"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, "drop", "L", "run", 0]
        }
      ]
    }
  ]
}
