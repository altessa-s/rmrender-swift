{
  "name": "Narrow rule, margin",
  "orientation": "portrait",
  "categories": ["Lines"],
  "constants": [
    {"compact": "templateWidth < 1000 || templateHeight < 1000"},
    {"pitch": 52},
    {"top": "compact ? 160 : 154"},
    {"margin": "paperOriginX + 478"}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": 0, "y": "top", "width": "templateWidth", "height": "pitch"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", "parentWidth", 0]
        }
      ]
    },
    {
      "type": "group",
      "boundingBox": {"x": "margin", "y": 0, "height": "templateHeight"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", 0, 0, "L", 0, "parentHeight"]
        }
      ]
    }
  ]
}
