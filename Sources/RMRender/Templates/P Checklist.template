{
  "name": "Checklist",
  "orientation": "portrait",
  "categories": ["Planners"],
  "constants": [
    {"compact": "templateWidth < 1000 || templateHeight < 1000"},
    {"row": 97.4},
    {"rule": "compact ? 179 : 192"},
    {"first": "compact ? 257 : 270"},
    {"box": 55},
    {"boxLeft": "compact ? 60 : paperOriginX + 320"},
    {"lineLeft": "compact ? 150 : paperOriginX + 445"},
    {"inset": 60}
  ],
  "items": [
    {
      "type": "text",
      "text": "Due date",
      "fontSize": 24,
      "position": {"x": "templateWidth - inset - textWidth", "y": "compact ? 138 : 152"}
    },
    {
      "type": "path",
      "data": ["M", 0, "rule", "L", "templateWidth", "rule"]
    },
    {
      "type": "group",
      "boundingBox": {"x": 0, "y": "first", "width": "templateWidth", "height": "row"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "path",
          "data": ["M", "boxLeft", 0, "L", "boxLeft + box", 0, "L", "boxLeft + box", "0 + box", "L", "boxLeft", "0 + box", "Z"],
          "strokeWidth": 1.5,
          "strokeColor": "#5A5A5A"
        },
        {
          "type": "path",
          "data": ["M", "lineLeft", "box", "L", "templateWidth - inset", "box"]
        }
      ]
    }
  ]
}
