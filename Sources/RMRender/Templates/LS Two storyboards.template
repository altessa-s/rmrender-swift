{
  "name": "Storyboard, two frames",
  "orientation": "landscape",
  "categories": ["Creative"],
  "constants": [
    {"fitWidth": "(templateWidth - 60) / 1751"},
    {"fitDepth": "(templateHeight - 20) / 1257"},
    {"fit": "fitWidth < fitDepth ? fitWidth : fitDepth"},
    {"scale": "fit < 1 ? fit : 1"},
    {"left": "templateWidth / 2 - 1751 * scale / 2"},
    {"frameWidth": "838 * scale"},
    {"frameHeight": "663 * scale"},
    {"gap": "75 * scale"}
  ],
  "items": [
    {
      "type": "group",
      "boundingBox": {"x": 0, "y": 0, "height": "templateHeight"},
      "repeat": {"rows": "down"},
      "children": [
        {
          "type": "group",
          "boundingBox": {"x": "left", "y": "58 * scale", "width": "frameWidth + gap"},
          "repeat": {"rows": 1, "columns": 2},
          "children": [
            {
              "type": "path",
              "data": ["M", 0, 0, "L", "0 + frameWidth", 0, "L", "0 + frameWidth", "0 + frameHeight", "L", 0, "0 + frameHeight", "Z"],
              "strokeWidth": 1.5,
              "strokeColor": "#8C8C8C"
            },
            {
              "type": "group",
              "boundingBox": {"x": 0, "y": "730 * scale", "width": "frameWidth", "height": "67 * scale"},
              "repeat": {"rows": 8},
              "children": [
                {
                  "type": "path",
                  "data": ["M", 0, 0, "L", "frameWidth", 0]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
